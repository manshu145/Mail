[Unit]
Description=NexiMail %i worker
After=network-online.target postfix.service
Wants=network-online.target

[Service]
Type=simple
User=neximail
Group=neximail
WorkingDirectory=/opt/neximail
EnvironmentFile=/opt/neximail/.env
ExecStart=/usr/bin/npm run worker:%i
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/neximail

[Install]
WantedBy=multi-user.target

# NexiMail isolated staging template
# Do NOT point these values at the current production NexiMail database, Redis, domains or secrets.
NODE_ENV=production
NEXIMAIL_DEMO_MODE=false
NEXIMAIL_RUNTIME_MODE=staging
NEXT_PUBLIC_NEXIMAIL_MODE=staging
NEXIMAIL_STAGING_SEND_ENABLED=false
NEXIMAIL_STAGING_MAX_RECIPIENTS=5000

APP_URL=https://staging.example.com
DATABASE_URL=postgres://neximail_staging:CHANGE_ME@127.0.0.1:5432/neximail_staging
REDIS_URL=redis://127.0.0.1:6380
AUTH_SECRET=CHANGE_ME_WITH_A_NEW_RANDOM_32_PLUS_CHAR_SECRET
PUBLIC_TOKEN_SECRET=CHANGE_ME_WITH_AN_INDEPENDENT_RANDOM_SECRET
MTA_EVENT_SECRET=CHANGE_ME_WITH_A_NEW_STAGING_SECRET
SEED_AGENT_SECRET=CHANGE_ME_WITH_A_NEW_STAGING_SECRET

OWNER_NAME=NexiMail Staging Owner
OWNER_EMAIL=staging-owner@example.com
OWNER_PASSWORD=CHANGE_ME_WITH_A_STRONG_STAGING_ONLY_PASSWORD

# Keep staging transport deliberately slow until the first controlled test succeeds.
POSTFIX_SENDMAIL_PATH=/usr/sbin/sendmail
TRANSPORT_RATE_PER_SECOND=1
CAMPAIGN_WORKER_INTERVAL_MS=5000
POLICY_WORKER_INTERVAL_MS=3000
TRANSPORT_WORKER_INTERVAL_MS=3000
EVENT_WORKER_INTERVAL_MS=10000
IMPORT_WORKER_INTERVAL_MS=3000
IMPORT_WORKER_BATCH_SIZE=250
VALIDATION_INTERVAL_MS=30000
VALIDATION_SMTP_TIMEOUT_MS=8000
VALIDATION_HELO=staging-validator.example.com
DOMAIN_HEALTH_INTERVAL_MS=300000
DKIM_SELECTOR=default
REPUTATION_INTERVAL_MS=300000
REPUTATION_BOUNCE_STOP_RATE=0.05
REPUTATION_COMPLAINT_STOP_RATE=0.003
REPUTATION_MIN_SAMPLE=100

# Only after staging DB/Redis/domain/sender are confirmed isolated:
# NEXIMAIL_STAGING_SEND_ENABLED=true

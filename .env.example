NODE_ENV=production
NEXIMAIL_DEMO_MODE=false

# Keep a newly installed panel isolated and sending-locked until its own DB,
# domain, sender identity and DNS have been verified.
NEXIMAIL_RUNTIME_MODE=staging
NEXIMAIL_STAGING_SEND_ENABLED=false
NEXIMAIL_STAGING_MAX_RECIPIENTS=5000
NEXIMAIL_SEND_ENABLED=false

APP_URL=https://mail.example.com
APP_BIND_PORT=3100
POSTGRES_DB=neximail_next
POSTGRES_USER=neximail_next
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://neximail_next:replace-with-a-strong-database-password@localhost:5432/neximail_next
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PUBLIC_TOKEN_SECRET=replace-with-an-independent-long-random-secret-at-least-32-characters
MTA_EVENT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
WEBHOOK_SECRET_KEY=replace-with-an-independent-long-random-secret-at-least-32-characters
DKIM_SECRET_KEY=replace-with-an-independent-long-random-secret-at-least-32-characters
FEEDBACK_INGEST_SECRET=replace-with-an-independent-long-random-secret-at-least-32-characters
OWNER_NAME="NexiMail Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password-at-least-12-characters
MTA_HOST=mta
MTA_PORT=10025
MTA_HOSTNAME=mail.example.com
MTA_PUBLIC_IP=replace-with-your-public-ipv4
MTA_MESSAGE_SIZE_LIMIT=26214400
MTA_SMTP_TIMEOUT_MS=15000

# VERP / delayed DSN bounce handling. New sending domains store their own
# bounce_domain (default suggestion: nm-bounce.<sending-domain>) in PostgreSQL.
# BOUNCE_DOMAIN is only a backward-compatible fallback for installations that
# predate per-domain bounce routing and for already queued legacy mail.
# Keep MTA_SMTP_BIND on loopback until bounce DNS and firewall are intentionally
# ready for inbound SMTP. When bounce MX is live, set MTA_SMTP_BIND=0.0.0.0.
BOUNCE_DOMAIN=bounce.example.com
BOUNCE_SECRET=replace-with-an-independent-long-random-secret-at-least-32-characters
BOUNCE_RECEIVER_PORT=2526
BOUNCE_MAX_MESSAGE_BYTES=2097152
MTA_SMTP_BIND=127.0.0.1

# Provider-scoped cooldown. A temporary Gmail/Yahoo/Microsoft/etc. restriction
# pauses only that provider for this sender; one probe is retried after the hold.
PROVIDER_COOLDOWN_MINUTES=15

TRANSPORT_RATE_PER_SECOND=1
TRANSPORT_MAX_ATTEMPTS=5
TRANSPORT_BATCH_SIZE=50
IMPORT_WORKER_INTERVAL_MS=3000
IMPORT_WORKER_BATCH_SIZE=250
CAMPAIGN_WORKER_INTERVAL_MS=5000
POLICY_WORKER_INTERVAL_MS=3000
TRANSPORT_WORKER_INTERVAL_MS=3000
EVENT_WORKER_INTERVAL_MS=10000
WEBHOOK_WORKER_INTERVAL_MS=3000
WEBHOOK_WORKER_BATCH_SIZE=25
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_REQUEST_TIMEOUT_MS=10000
VALIDATION_INTERVAL_MS=30000
VALIDATION_API_TIMEOUT_MS=10000
SUPERSEND_API_KEY=
SUPERSEND_VERIFY_URL=https://api.supersend.io/v1/verify-email
DOMAIN_HEALTH_INTERVAL_MS=300000
DKIM_SYNC_INTERVAL_MS=60000
REPUTATION_INTERVAL_MS=300000
REPUTATION_BOUNCE_STOP_RATE=0.05
REPUTATION_COMPLAINT_STOP_RATE=0.003
REPUTATION_MIN_SAMPLE=100

# Promote only after isolated validation is complete:
# NEXIMAIL_RUNTIME_MODE=production
# NEXIMAIL_SEND_ENABLED=true
